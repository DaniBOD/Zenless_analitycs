# ==========================================================================
# DaniBOD ZZZ Analytics — .gitignore
# ==========================================================================

# ────────────── Python ──────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Virtual envs
.venv/
.venv_spike/
venv/
env/
ENV/

# Embedder ONNX (pivote E.0 descartado 2026-06-16 — regenerable con tools/export_embedder_onnx.py)
app/resources/avatar_embedder.onnx
app/resources/avatar_embedder.json

# Build / dist artifacts
build/
dist/
*.egg-info/
*.egg
*.spec.bak

# PyInstaller — bundle output gitignored, spec versionado
app/build/
!app/build/main.spec
*.manifest

# QA visual artifacts — regenerables con tools/annotate_rois.py y tools/render_toast_preview.py
Documentacion/QA/calibracion_visual/

# ────────────── IDE / Editor ──────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.qodo/
.claude/

# ────────────── OS ──────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ────────────── DB runtime artifacts ──────────────
# Backups intermedios creados por scripts (regenerables — no se versionan)
db/danibod_zzz_v2.backup_*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
# Basura de conexiones rotas
db/*.db?*

# Mantenemos: db/danibod_zzz_v2.db (DB activa, fuente de verdad estructural)
# Mantenemos: db/migrations/ (SQL aplicadas)
# Mantenemos: audit/*.backup_*.db (snapshots de auditoría intencionales)

# ────────────── Inventario crudo (screenshots full-res del juego) ──────────────
# Capturas binarias pesadas (~200MB) que el usuario regenera con la app.
# Si en algún momento se quieren versionar, mover a Git LFS y eliminar esta línea.
Inventario/

# ────────────── Configuración personal del usuario ──────────────
app/config/user_config.toml
app/config/rois.toml.user
.env
.env.local

# ────────────── Logs y reportes runtime ──────────────
logs/
*.log
audit/*_running_*.md
app/tests/_tmp/
app/tests/__snapshots__/_actual_*

# ────────────── Artefactos efímeros de cosecha/diagnóstico (Fase 5R) ──────────────
# Volcado de frames completos de cosecha (DANIBOD_HARVEST) — pesa GBs, regenerable.
audit/harvest/
# Montages/recortes de diagnóstico (diag_grid_*.py), QA shots y badges extraídos —
# regenerables desde los frames etiquetados + las tools. No son fuente de verdad.
audit/grid_diag/
audit/qa_shots/
audit/labeled_badges/
# Frames full-res de validación de la grilla (~71 MB) — verdad de tierra del test
# test_grid_owner_real_frames (skip-if-absent). Se mantienen locales (decisión usuario
# 2026-06-12); el test corre en la máquina del usuario.
Documentacion/Screenshots_Triggers/Discos_Triggers/16_discos_pj_grilla/
# Mapa disco→dueño (verdad de tierra del flujo-ancla, Fase 5R.C) — regenerable con un
# pase de cosecha, específico de la cuenta del usuario.
audit/equip_map_*.json
# Videos de flujo (capturas del juego para tests del pipeline) — cientos de MB. El .mp4
# crudo queda LOCAL; la doc de verdad de tierra (.md/.txt) SÍ se versiona como fixture.
Documentacion/Videos_flujo/*.mp4
Documentacion/Videos_flujo/*.mkv
Documentacion/Videos_flujo/*.avi
Documentacion/Videos_flujo/*.mov

# ────────────── Mockups runtime state ──────────────
# DesignCanvas guarda estado de orden/títulos en sidecar JSON
.design-canvas.state.json
Documentacion/Interfaz/mockups/Codigos-claude-desing/.design-canvas.state.json

# ────────────── Skills / sessions de asistentes ──────────────
.skills-plugin/
local-agent-mode-sessions/

# ────────────── Personal ──────────────
# CV de Daniel: archivo personal, no forma parte del proyecto (pedido 2026-07-19)
cv_daniel_pilquil.docx
